// DisPlayer — 組み込みディスプレイライブラリ (読み取り専用リファレンス)
// .jb コードで作ったライブラリではなく、エディタに入っているライブラリです。
//
// ── 使い方 ─────────────────────────────
//   Use DisPlayer call dis;      エイリアス (dis) は自由に
//
// ── コマンド ───────────────────────────
//   dis.setDisplay();            画面いっぱいのディスプレイを開く
//                                · 黒い背景、中央に灰色の DisPlayer ロゴ (色を変えると消える)
//                                · 上の余白 + 右上の ✕ (押すと閉じて実行も止まる)
//                                · 座標 (0, 0) は画面の中央 (右 · 上が +)
//                                · 左下の隅に小さく [screenX, screenY] (画面サイズ) を表示
//   dis.disableScreenScale();    隅の [screenX, screenY] 表示をオフ
//   dis.enableScreenScale();     再びオン (デフォルトはオン)
//   dis.setDisplayColor("#hex"); ディスプレイの色を 16 進カラーコードで設定 ("#000", "#1e90ff")
//   dis.setFont("パス.ttf");      文字オブジェクト (dis.setText) のフォントを変える — すべての文字が新しいフォントに (.ttf のみ)
//                                · フォントは 開く · ドラッグ＆ドロップ でプロジェクトに入れる (ファイル一覧で押すとプレビュー)
//                                · Magellan を使うなら mag.importFile("fonts/a.ttf") save as ("a"); で付けた名前も可: dis.setFont("a");
//                                · 読み終えてから次の行へ · 文字の幅も新しいフォントで測り直す
//                                · このとき中央のロゴが消える
//   dis.setupObject();           このプロジェクトでオブジェクト機能をオン (オブジェクトのコマンドより先に!)
//   dis.waitF(n);                画面のフレーム n 個分待つ (通常 60fps → 1 フレーム ≈ 16.7ms)
//                                毎フレーム回すループに:  loop{ obj.ball.Xpos = obj.ball.Xpos + 2; dis.waitF(1); }
//                                (見えていないタブでは休み、また続きから · C 変換ではウィンドウのフレーム、約 60fps)
//
// ── オブジェクト ───────────────────────
//   [] は行列 — 位置・サイズは (1, 2) 行列、位置はオブジェクトの中心
//   dis.setObject([x, y], "id", [幅, 高さ], 色);
//                                色: "#ff8800"、または 114514 のように数字 3・6 桁 (16 進として読む)
//                                同じ id なら上書き · 最初に描かれると中央のロゴが消える
//   dis.setObjCyl([x, y], "id", 半径, 色);
//                                円オブジェクト — 位置は円の中心 · Scale = [直径, 直径]
//                                (Scale の幅・高さを別々にすると楕円) · 衝突判定はまだ四角形基準
//   dis.setObjPlg([x1, y1], [x2, y2], [x3, y3], [x4, y4], "id", 色);
//                                多角形オブジェクト — 頂点 3 個 (三角形) または 4 個 (頂点は画面座標 · 外周に沿って順番に)
//                                · dis.setObjPlg([0, 0], [100, 0], [50, 80], "tri", "#ffffff");   ← 頂点 3 個
//                                · 位置 = 頂点を囲む四角形の中心 · Scale = その四角形のサイズ (変えると形がその比率で伸びる)
//                                · 移動 · 回転 · 不透明度 · レイヤー · 親 · 子 · UI は他のオブジェクトと同じ
//                                · マウス判定 (isMouseTouched · ボタン) は多角形の形どおり · コライダーは別 (四角形) · テクスチャは不可
//   dis.setObjAlpha("id", 0 ~ 255);
//                                不透明度 — 0 = 見えない · 255 = 不透明 (デフォルト) · 範囲外は 0 · 255 に丸める
//   dis.setObjColor("id", 色);    色を変える (obj.id.Color = 色; と同じ)
//   dis.setObjOverlay("id", 色, 0 ~ 255);
//                                オブジェクトの形のままその色を重ねる — 0 = なし · 255 = その色で完全に覆う (テクスチャは不透明な部分だけ · 文字は文字の形だけ)
//                                · 元の色 · テクスチャはそのまま (オーバーレイを 0 にすると元どおり) · オブジェクトの不透明度が低いとオーバーレイもその分薄くなる
//   dis.rotateObj("id", 角度, ms);
//                                現在の角度からさらに角度 (度) だけ回す — 反時計回りが +、負 = 時計回り · ms かけて徐々に (0 = すぐに)
//                                · 回っている途中でまた呼ぶとその目標からさらに回る (90 を 2 回 = 180) · 始まると 1 フレーム後に次の行へ · 終わりは待たない
//                                · 絵 · 円 · 文字 · テクスチャ · マウス判定 (isMouseTouched · ボタン) · コライダー · トリガーが一緒に回る
//                                  (コライダー · トリガーはオブジェクトの中心を軸に間隔ごと回る · 回ったコライダー同士も正確にぶつかる)
//                                · 一緒に動くものもひとかたまりで一緒に回る (位置がピボットを軸に回り、角度も同じだけ加わる)
//                                  - 子 (とその子): 親のピボット (位置) を軸に
//                                  - setLink で結んだオブジェクト: 結ばれたオブジェクトのピボットの中心を軸に (2 つなら 2 つのピボットの中点) — 回したオブジェクトもその軸を回る
//                                  - 子を回すとその子 (とその下) だけ回る · 親はそのまま
//                                · "<タグ>" も可
//   dis.setTilemap([x, y], "タイルマップ");  タイルマップエディタの .tl を配置 — マップの [0, 0] 地点を [x, y] に · タイル 1 マス = tileSize 単位
//                                · [0, 0] 地点 = タイルマップエディタの ⌖ で決めたマスの中心 (決めていなければマップの中央)
//                                · "タイルマップ" = mag.importFile("map.tl") save as ("タイルマップ") で付けた名前、または .tl のパス
//                                · テクスチャは .tl の中に入っている · レイヤーごとにオブジェクト 1 つ ("名前.layer0" …、他のものより下に)
//                                · コライダータイルは見えない壁として自動で設置 ("名前.col…") — 同じファイルに Use colliders が必要
//                                · はしごブロックのマスはふさがない · 同じ名前でもう一度配置すると前のものは消える · 画像を描き終えると次の行へ
//                                · C 変換はまだ未対応
//   dis.setRenderLimit(半径);     メインカメラの中心から半径 (画面ピクセル) の内側のオブジェクトだけ描画 — 0 = 制限なし (デフォルト)
//                                · 少しでも円の内側にかかれば描画 · 描画だけ減らす (物理 · 衝突 · コードはそのまま)
//                                · カメラの倍率が 2 ならワールド座標では半径 / 2
//   ── for ms: 時間をかけて変える ──
//   dis.setObjAlpha("id", 0) for 500;           500ms かけて徐々に (フェードアウト)
//   dis.setObjColor("id", "#ff5d8f") for 800;   色が徐々に変わる
//   dis.setObjOverlay("id", "#ffffff", 255) for 250;   徐々に白く覆われる (もう一度 0 に for 250 → 元の色へ)
//   dis.setObjScale("id", [200, 200]) for 300;  サイズが徐々に (文字は文字サイズ)
//   dis.setObjPos("id", [0, 0]) for 400;        moveObj のように動く (終わりを待たない)
//                                · 変わり始めると (最初のフレームで) すぐ次の行へ — だから複数をいっしょに変えられる
//                                  (終わるまで待つには jaw.wait(ms) · moveObj は移動が終わってから次の行) · for 0 / 省略 = すぐに
//                                · 同じオブジェクト · 同じプロパティをもう一度変えると前のものはその場で終了 · "<タグ>" ならすべて一緒に
//   dis.setObjPos("id", [x, y]);            位置を変える
//   dis.setObjScale("id", [幅, 高さ]);       サイズを変える
//   dis.setText([x, y], "文字の内容", "id", サイズ, 縁取り, 色);
//                                文字オブジェクト — 文字の内容を画面に書く (位置は文字の中心)
//                                サイズ = 実際の文字の高さ (画面単位のピクセル数 · 一番高い文字 H・あ の上端 ~ 一番低い文字 g・y の下端)
//                                       どんなフォントでもサイズ 32 なら文字が 32 マスの高さ · 縁取り = true/false (文字色と対比する色)
//                                obj.id.Text = "新しい文字"; で内容だけ変えられる
//                                · "1 行目\n2 行目" のように \n で複数行 (中央揃え · 行間 = サイズ × 1.2 · 幅 = 一番長い行)
//                                Scale は [文字の幅, 文字サイズ] (自動) · Scale の Y を変えるとフォントサイズ
//   dis.setTextNudge("id", "left");
//                                文字オブジェクトの位置の基準点 — デフォルト "center" (位置 = 文字の中心)
//                                "left" 位置 = 左端 · "right" 右端 · "top" 上端 · "bottom" 下端
//                                "top left" のように 2 つを合わせるとその角 ("topleft" · "left-top" も可)
//                                · 文字が長くなっても変わっても基準点はそのまま (左揃え · 右揃えのスコアボードなど)
//                                · 押下 · トリガーなどの判定も実際の文字の位置で · nudgeObj も基準点に合わせて寄せる
//   dis.setObjNudge("id", "left");
//                                オブジェクト (四角形 · 円 · 多角形 · 画像 · 文字) の位置の基準点 (ピボット) — 方式は setTextNudge と同じ
//                                · "left" なら位置 = 左端 → setObjScale で幅を縮めても左端はそのまま (HP バーなど)
//                                · 回転は今までどおり中心基準 · コライダー · トリガーの位置はそのまま (位置 + オフセット)
//   dis.nudgeObj("id", [左, 上], x 間隔, y 間隔);
//                                画面の端に寄せる — [左, 上] は bit 行列
//                                [true, true] 左上 · [false, true] 右上
//                                [true, false] 左下 · [false, false] 右下
//                                間隔 = 端から離す px (dis.setDisplay() の後に)
//   dis.moveObj("id") to [x, y] for ms;     ms かけて [x, y] へまっすぐ移動
//   dis.moveObj("id") to [x, y] for ms ease ("sinleft");
//                                移動の速さのカーブ — dis.setObjPos(…) for ms ease (…) も可
//                                "linear" 一定 (デフォルト) · "sin" サイン 0° ~ 90° (終わりで遅くなる)
//                                "sinright" 0° ~ 45° (ほぼ一定) · "sinleft" 45° ~ 90° (速く出て終わりで急に遅くなる)
//                                to には [x, y] か matrix[1, 2] 変数 (例: to coord)
//                                for を省くと 0 (すぐに移動) · 移動が終わってから次の行へ
//                                (同時に動かすには run{ } を複数)
//                                行列の中の obj.Xpos · obj.Ypos · obj.Xscale · obj.Yscale
//                                = そのオブジェクトの現在の値 (例: [obj.Xpos + 10, obj.Ypos])
//   dis.setParent() ("子") as ("親");
//                                親が動くと子も一緒に動く (子は単独でも動ける)
//                                · ( ) の中は id の文字列 — 変数 · "a" + n も可 · "" = 自分自身 (バインドされたファイル)
//                                自分自身や自分の子を親にするとエラー
//   dis.setLink("id1", "id2");   2 つのオブジェクトを結ぶ — どちらが動いても、もう一方が同じだけ一緒に動く
//                                · 親 · 子の関係とは無関係 (親 · 子同士を結んでも 1 回だけ動く)
//                                · 結んだもの同士はつながる: setLink("a", "b"); setLink("b", "c"); → a · b · c が一緒に
//                                · dis.setLink("id", ""); = そのオブジェクトを結びから外す · 削除すると自動で外れる
//                                · 位置 · 速度 · 衝突 · moveObj · obj.id.Xpos = … などどんな移動でも · サイズ · 色は別
//                                · "<タグ>" も可 (タグの付いたオブジェクトごとに結ぶ) · col.setLink も同じ
//   dis.escParent("id");         親からの継承を解除 — このオブジェクトが親から離れる (位置はそのまま · 親がなければ何も起きない)
//   dis.splitParent("id");       親の家族を解散 — このオブジェクトの子をすべて切り離す (子は残り、位置はそのまま)
//   dis.removeObj("id");         オブジェクトを削除 (子は残り、親の関係だけ解ける)
//   dis.disableObj("id");        オブジェクトを無効化 — 描画せず · 動かず · 衝突 · トリガー · マウス判定なし
//                                (削除はされない · 値は読み書きできる · 子も一緒に無効 · バインドされたコードは休む)
//   dis.enableObj("id");         再び有効化 (止まっていた速度 · コードが続きから動く)
//   dis.setTxtContent("id", "内容");  文字オブジェクト (dis.setText で作ったもの) の内容を変える — obj.id.Text = "内容"; と同じ
//                                · 数値は "" + 値 で · "<タグ>" · "" (自分自身) も可 · 文字でないオブジェクトならエラー
//   dis.setObjLayer("id", n);    描画順 (レイヤー) — 大きいほど上に描く · デフォルト 0 · 同じなら先に作ったものが下
//   dis.ascendObjLayer("id", n); オブジェクトとその子 (とその下の子) すべてのレイヤーを n だけ上げる · 負なら下げる
//                                · それぞれのレイヤーに足すので、親 · 子の間の順番はそのまま · "<タグ>" も可
//   dis.tagObj("id", "タグ");     オブジェクトにタグを付ける (複数可 · 作り直しても維持)
//                                id 欄に "<タグ>" と書くと、そのタグが付いたオブジェクトすべてに同じコマンド
//                                (dis.setObjPos("<enemy>", [obj.Xpos, obj.Ypos - 5]);  dis.removeObj("<bullet>");
//                                 col.setVelocity("<enemy>", [0, -50]);  dis.moveObj("<coin>") to [0, 0] for 300;)
//                                · 行列の中の obj.Xpos などは、オブジェクトごとにそのオブジェクトの値
//                                · moveObj はすべて一緒に動き、全部終わると次の行へ · タグの付いたものがなければ何も起きない
//                                · getVar のように値を 1 つ読むコマンドには使えない
//   dis.getVar("id", "名前") as 変数;
//                                名前: coord(= position) · scale · color · text
//                                      · 要素は "scale[1, 2]" のように
//                                受け取る変数の型が同じであること:
//                                coord/scale → matrix[1, 2] · 要素 → float · color → string
//   obj.id.Position / obj.id.Scale / obj.id.Color / obj.id.Text
//   obj.id.Xpos / obj.id.Ypos / obj.id.Xscale / obj.id.Yscale   (float の要素)
//                                変数のように読み書きする (var float call x = obj.yaju.Xpos;  obj.yaju.Ypos = 300;)
//                                (obj.yaju.Position = [100, 200];  obj.yaju.Scale[1, 1] = 50;)
//
// ── ファイルのバインド (バインドするファイルの run{ } の直下に書く) ──
//   dis.BelongObj("id");         このファイル全体をオブジェクトにバインド — その id のオブジェクトが作られた瞬間に
//                                このファイルの run{ } がそのオブジェクトを基準に最初から実行される
//                                · パスは書かない: バインド宣言のある .jb ファイルは、誰も呼ばなくても自動で読み込まれる
//                                · どの run{ } に書いてもファイル全体がバインド · 何度も書けば複数のオブジェクトにバインド
//                                · まだバインドされないまま実行中なら (main · sendto で実行したファイル) その行ですぐにバインド
//                                  → それ以降、このファイルのすべての run{ } で obj.Xpos · "" の id · 子の作成などがそのオブジェクト基準
//                                  (そのオブジェクトが先にあること · すでにバインドされた実行では何もしない)
//                                · if · loop の中には書けない · id は空にできない · タグ "<…>" は不可
//                                · main はオブジェクトができたときに別途実行されず、その行でだけバインド (BelongScene は main に書けない)
//                                · dis.removeObj で削除するとバインドされたコードも止まる (作り直すと最初から)
//                                · 複数のオブジェクトにバインドすると、オブジェクトごとに別々に実行 (変数も別々)
//   バインドされたファイルの中では:
//     obj.Xpos · obj.Position · obj.Color · obj.Text …   id なしで = 自分自身 (obj.Ypos = 10; も可)
//     コマンドの id 欄を "" と空にすると自分自身  (dis.setObjPos("", [0, 0]);  col.setVelocity("", [50, 0]);)
//     ファイルのトップレベルの var と run{ } 直下の var = そのオブジェクトの変数 (オブジェクトごとに別々)
//       → 他のファイルから obj.id.変数 で 1 つずつ読み書きする (obj.hero.hp = 50;  obj.enemy2.speed = 3;)
//       (run{ } の中の var はその行が実行された後から · loop · if の中の var は不可)
//     ここで新しく作ったオブジェクトは自動でそのオブジェクトの子 (親について動く)
//     親オブジェクトにバインドされたファイルの変数 (public でないローカル変数も) は、子のバインドコードから名前だけで読み書きできる
//       (親 → その親 … 近い祖先から探す · 自分の変数が同じ名前なら自分のものが優先)
//     (setObjPos のようなコマンドの行列の中では、obj.Xpos は今変更しているオブジェクトの値)
//   例)  main.jb:    run{ dis.setupObject(); dis.setObject([0, 0], "hero", [40, 40], "#fff"); obj.hero.hp = 80; }
//        player.jb:  var int call hp = 100;
//                    run{ dis.BelongObj("hero"); dis.setObject([obj.Xpos, obj.Ypos + 30], "hpbar", [40, 6], "#f44"); obj.Ypos = 50; }
//
// ── 変数 (読み取り専用、エイリアスによって名前が変わる) ──
//   dis.displayX                 ディスプレイの幅 (画面単位)
//   dis.displayY                 ディスプレイの高さ (画面単位、上の余白を除く)
//                                setDisplay() の前は 0 · ウィンドウサイズが変わると一緒に変わる
//   dis.idWidthmode              bit — 横向き (幅 ≥ 高さ) なら 1、縦向きなら 0 (画面を回すと変わる)
//
// ── 画面単位 (端末に関係なく同じ大きさ) ────
//   画面の短い辺が常に 720 — 縦向きなら幅が 720、横向きなら高さが 720 (長い辺は画面の比率どおり)
//   · 位置 · サイズ · 文字サイズ · 速度 · マウス (can.MouseX/Y) · displayX/Y · setRenderLimit すべてこの単位
//   · 例: 縦向きのスマートフォン 390 × 844 px → 720 × 1558 · 横 1280 × 720 のウィンドウ → 1280 × 720 · 隅の [screenX, screenY] もこの単位
//   · 短い辺の端は常に ±360 — [0, 300] はどの端末でも上の方 (縦向きなら上下にもっと広い)
//
// ── 例 ─────────────────────────────────
//   Use DisPlayer call dis;
//   run{
//       dis.setDisplay();
//       dis.setDisplayColor("#101820");
//       print("画面サイズ: %dis.displayX% x %dis.displayY%");
//
//       dis.setupObject();
//       dis.setObject([500, 500], "yaju", [200, 200], 114514);
//       var float call w = 0;
//       dis.getVar("yaju", "scale[1, 1]") as w;
//       dis.setObjScale("yaju", [obj.Xscale * 2, obj.Yscale]);
//       obj.yaju.Position[1, 2] = 300;
//       dis.moveObj("yaju") to [obj.Xpos + 200, obj.Ypos] for 1000;
//       dis.setText([0, 0], "SCORE 0", "score", 28, true, "#ffd166");
//       dis.nudgeObj("score", [true, true], 16, 12);   // 左上に寄せる
//       obj.score.Text = "SCORE 10";
//   }
//
// · C 変換: DisPlayer · colliders · Canvas · Magellan を使うと、SDL2 でウィンドウ (ポップアップ) を開いて同じように描画し、動かします。
//   ビルド:  gcc main.c -o main -pthread -lm $(sdl2-config --cflags --libs)   (文字を使うなら + -lSDL2_ttf · 画像を使うなら + -lSDL2_image)
//   · プログラムは別のスレッドで動き、ウィンドウは約 60fps · ウィンドウを閉じるとプログラムも終了
//   · ウィンドウを開いていなければプログラムの終了時に終了 · 開いていればウィンドウを閉じるまで (速度 · 物理は続く)
//   · 文字はハングル対応フォントを自動で探します (見つからなければ JB_FONT=フォント.ttf で指定)
//   · バインドされたファイル (BelongObj · BelongScene) の run は、それぞれ別のスレッドで同時に実行
