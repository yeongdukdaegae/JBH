// Magellan — DisPlayer の下位組み込みライブラリ · 画像 · テクスチャ (読み取り専用リファレンス)
// DisPlayer に従属します: 同じファイルに Use DisPlayer が必要です。
//
// ── 使い方 ─────────────────────────────
//   Use DisPlayer call dis;
//   Use Magellan call mag;
//
// ── 画像を入れる ───────────────────────
//   ☰ 開く · ドラッグ＆ドロップで .png · .jpg · .gif · .webp · .bmp をプロジェクトに入れる
//   (サウンド .wav · .mp3 · .ogg · .m4a も同じ方法で入れ、importFile で名前を付けて soundMaster で使う)
//   (フォント .ttf も importFile で名前を付けて dis.setFont("名前") で使う)
//   (zip でエクスポートすると画像も一緒に入る · ファイル一覧で押すとプレビュー)
//
// ── コマンド ───────────────────────────
//   mag.importFolder("パス");
//                                そのフォルダ (サブフォルダを含む) 内の画像 · サウンド · フォント · タイルマップすべてに名前を付ける
//                                · 名前 = 拡張子を除いたファイル名 (assets/sounds/choose.mp3 → "choose")
//                                · 名前が重複するとエラー (そのファイルだけ importFile で個別に) · "" = プロジェクト全体 · パスはダブルクォートで囲んだリテラル
//   mag.importFile("パス") save as ("id");
//                                パスに短い名前 (id) を付ける — ファイルをコピーしたり別に保存したりはせず、以後 id がそのパスになる
//                                · 名前はプログラム全体 (すべてのファイル) で共有 · 同じ id でもう一度やると別のパスを指す
//                                · パスはダブルクォートで囲んだリテラル (プロジェクトのルート基準、./ ../ は現在のファイル基準)
//                                · 待たずにすぐ次の行へ (画像はファイルを読み終えると表示される)
//   mag.setObjTexture("id", "画像の名前", [x1, y1], [x2, y2]);
//                                オブジェクトに画像の [x1, y1] ~ [x2, y2] の部分を貼る (画像のピクセル · 左上が [0, 0])
//                                · オブジェクトの色は #ffffff になる — 色を変えると色の効果 (乗算)
//                                  (dis.setObjColor("id", "#ff8080"); 赤っぽく · for ms で徐々にも可)
//                                · 円は四角い画像の四隅を切り落とした形で貼られる
//                                · x2 < x1 なら左右反転 · y2 < y1 なら上下反転
//                                · 不透明度 · レイヤー · サイズ · タグ ("<タグ>") はすべてそのまま · 画像の名前を "" にするとテクスチャをはがす
//                                · スプライトシート: 同じ画像でマスだけ変えてアニメーション (下のテクスチャ · アニメーションの方が便利)
//
// ── テクスチャ ─────────────────────────
//   mag.setasTexture("画像の名前", [x1, y1], [x2, y2]) save as ("テクスチャ id");
//                                画像の [x1, y1] ~ [x2, y2] の四角形をテクスチャにして id を付ける (反転 · 範囲のルールは setObjTexture と同じ)
//                                · id はプログラム全体で共有 · 同じ id でもう一度やると置き換わる
//   mag.wearTexture("オブジェクト id", "テクスチャ id");
//                                オブジェクトにテクスチャを貼る · "" = はがす · "<タグ>" も可
//                                · 最初に貼るとき色が #ffffff に (色を変えると色の効果) · 再生中のアニメーションは止まる
//
// ── アニメーション ─────────────────────
//   mag.setasAnime(["テクスチャ id", …], ms, "アニメ id");
//                                テクスチャを順番に ms 間隔で表示するアニメーション (リスト変数も可)
//   mag.obj.id.applyAnime("アニメ id");        アニメーションを再生 (1 倍速 · 1 回)
//   mag.obj.id.runAnime("アニメ id", 倍速);     その倍速で再生 (2.0 = 2 倍速く · 0.5 = 半分)
//                                · 1 回再生して最後のフレームで止まる · 待たずにすぐ次の行へ
//                                · 再生中にもう一度呼ぶと (別のアニメでも同じアニメでも) 今のものが終わってから切り替わる — 最後に呼んだもの 1 つ
//                                  (歩いている間、毎フレーム runAnime("walk", 1.0) を呼べば途切れずに繰り返す)
//   mag.obj.id.breakAnime();                  アニメーションを停止 — 停止したフレームのテクスチャのまま · 待っていた次のアニメも取り消し
//   mag.obj.id.animeFrame                     int — 今表示されているアニメーションのフレーム (1 から) · 再生中でなければ -1
//                                · バインドされたファイルでは mag.obj.runAnime("walk", 1.0); · mag.obj.animeFrame = 自分自身
//                                · 文字 · 見えないオブジェクトには使えない
//
// ── 例 ─────────────────────────────────
//   Use jawbreaker call jaw;
//   Use DisPlayer call dis;
//   Use Magellan call mag;
//   run{
//       dis.setDisplay();
//       dis.setupObject();
//       mag.importFile("img/hero.png") save as ("hero");
//       dis.setObject([0, 0], "player", [96, 96], "#fff");
//       mag.setasTexture("hero", [0, 0], [32, 32]) save as ("w1");     // 32 × 32 のマス 4 つ
//       mag.setasTexture("hero", [32, 0], [64, 32]) save as ("w2");
//       mag.setasTexture("hero", [64, 0], [96, 32]) save as ("w3");
//       mag.setasTexture("hero", [96, 0], [128, 32]) save as ("w4");
//       mag.wearTexture("player", "w1");
//       mag.setasAnime(["w1", "w2", "w3", "w4"], 120, "walk");
//       loop{   // 押している間は歩行を繰り返す · 離すと止まる
//           if [jaw.isKeyInput("right")]{ mag.obj.player.runAnime("walk", 1.5); }
//           else{ mag.obj.player.breakAnime(); }
//           dis.waitF(1);
//       }
//   }
//
// · C 変換: 名前が指すパスの画像ファイルを、最初に使うときに SDL2_image で読み込みます (プロジェクトフォルダで実行)。
