// soundMaster — Magellan の下位組み込みライブラリ · サウンド (読み取り専用リファレンス)
// Magellan (DisPlayer の下位) に従属します: 同じファイルに Use DisPlayer と Use Magellan が必要です。
//
// ── 使い方 ─────────────────────────────
//   Use DisPlayer call dis;
//   Use Magellan call mag;
//   Use soundMaster call sou;
//
// ── サウンドを入れる ───────────────────
//   ☰ 開く · ドラッグ＆ドロップで .wav · .mp3 · .ogg · .m4a をプロジェクトに入れる (ファイル一覧で押すと試聴)
//   mag.importFile("sfx/jump.wav") save as ("jump");   画像と同じようにパスに名前を付けて使う
//
// ── スピーカー ─────────────────────────
//   sou.setSpeaker("名前");         スピーカーを作成 — 音はすべてスピーカーが鳴らす (同じ名前でもう一度やってもそのまま)
//                                   · スピーカー = 見えないオブジェクト (id "spk.名前") — カメラのように spk.名前.Position で読み書きする
//                                   · デフォルトではすべてのシーンで聞こえる — 1 つのシーンだけ: sou.spk.名前.belongtoScene("シーン");
//                                   · dis.disableObj("spk.名前") = すぐに無音 (フェードなし) · 今後オブジェクト名は "spk." で始められない
//   sou.setVol("スピーカー", 0 ~ 255);  音量 (デフォルト 255) · フェードがあればその時間をかけてゆっくり変わる
//   sou.setFadein("スピーカー", ms);  音が鳴り始めるとき ms かけてだんだん大きくなる (0 = すぐに)
//   sou.setFadeout("スピーカー", ms);  音が止まるとき ms かけてだんだん小さくなる — break · 再生時間の終わり · 繰り返しの終わり すべて
//   sou.spk.スピーカー.belongto("オブジェクト");
//                                   スピーカーをオブジェクトにバインド — そのオブジェクトへ移動して子になる (ついていく) · 空間オーディオ ("" = 解除)
//   sou.spk.スピーカー.belongtoScene("シーン");
//                                   スピーカーをシーンにバインド — そのシーンにいる間だけ聞こえ、他のシーンでは無音 ("*" = すべてのシーン · can.setUpScene が必要)
//                                   · 画面 (カメラ) の中央から遠いほど小さく · 左 · 右に分かれて聞こえる
//                                   · オブジェクトがない、無効、または現在のシーンにないときはすぐに無音 (フェードなし) · また現れると聞こえる
//
// ── 再生 ───────────────────────────────
//   sou.playSfx("スピーカー", "サウンド", ms);
//                                   サウンドを 1 回再生 — ms ミリ秒まで (サウンドがそれより短ければ最後まで · 0 = 最後まで)
//                                   · 待たずにすぐ次の行へ · 1 つのスピーカーで複数の音を重ねて鳴らせる
//   sou.repeatingPlay("スピーカー", "サウンド", 回数);
//                                   繰り返し再生 — 回数 0 = 無限に繰り返す (break で止める)
//   sou.repeatPart("スピーカー", "サウンド", 開始, 終了);
//                                   開始 ~ 終了 (ミリ秒) の区間だけ無限に繰り返す — 最初は開始地点から · break で止める
//                                   · 終了が負ならサウンドの最後まで (例: イントロの後の本編だけ繰り返す: sou.repeatPart("bgm", "song", 8000, -1);)
//                                   · フェードイン · 音量 · 空間オーディオは他の再生と同じ · sou.repatPart と書いても同じコマンド
//   sou.introPart("スピーカー", "サウンド", 開始, 終了);
//                                   サウンドを最初から再生し、終了地点に達したら開始 ~ 終了の区間だけ無限に繰り返す (イントロのある BGM)
//                                   · 終了が負ならサウンドの最後まで · C 変換では repeatPart のように開始地点から再生される
//   sou.break("スピーカー");        そのスピーカーの音をすべて止める (フェードアウトに従う)
//   sou.break("スピーカー", true);  フェードアウトを無視してすぐに止める (false = フェードアウトに従う)
//
// ── 例 ─────────────────────────────────
//   run{
//       dis.setDisplay();
//       dis.setupObject();
//       dis.setObject([300, 0], "bird", [30, 30], "#ffd166");
//       mag.importFile("sfx/chirp.ogg") save as ("chirp");
//       sou.setSpeaker("birdSpk");
//       sou.setFadein("birdSpk", 300);
//       sou.setFadeout("birdSpk", 500);
//       sou.spk.birdSpk.belongto("bird");          // 右から聞こえる
//       sou.repeatingPlay("birdSpk", "chirp", 0);
//       jaw.wait(3000);
//       sou.break("birdSpk");                       // 0.5 秒かけて小さくなって止まる
//   }
//
// · ブラウザが音をブロックする場合は、画面を 1 回押してからもう一度実行してください。
// · プログラムを止める (■) か、もう一度実行すると、音もすべて止まります。
// · C 変換: SDL2_mixer で同じパスのサウンドファイルを再生します (ビルドに -lSDL2_mixer)。
//   音量の変更は、C ではフェードなしですぐに変わります。
