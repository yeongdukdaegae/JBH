// SeongBin — Canvas 의 하위 내장 라이브러리 · 카메라 (읽기 전용 설명서)
// Canvas(DisPlayer 하위)에 종속됩니다: 같은 파일에 Use DisPlayer 와 Use Canvas 가 있어야 합니다.
//
// ── 사용 ───────────────────────────────
//   Use DisPlayer call dis;
//   Use Canvas call can;
//   Use SeongBin call seo;
//
// ── 명령어 ─────────────────────────────
//   seo.setUpCam();                 카메라 기능 켜기 — 기본 카메라 cam.default 가 생김
//                                   · cam.default: 장면에 들어갈 때마다 새로 (가운데 [0, 0] · 배율 1 · 따라가기 없음) · 모든 장면에 있음
//   seo.setCam("이름");             카메라 만들기 — 보이지 않는 오브젝트 (id 는 "cam.이름")
//                                   · 만든 장면에 있음 (can.obj.setExistableScene 으로 다른 장면에도) · 비활성화할 수 없음
//                                   · 장면의 메인 카메라는 기본으로 cam.default — 메인 카메라의 위치가 화면 가운데
//                                   · 이제 오브젝트 이름은 "cam." 으로 시작할 수 없음 (스피커의 "spk." 도)
//   seo.setMainCamas("이름");       지금 장면의 메인 카메라를 바꿈 (여러 카메라 · "default" = cam.default)
//   seo.cam.이름.setZoom(배율);     배율 (1 = 그대로 · 2 = 두 배로 크게 보임 · 0 보다 커야 함)
//   seo.cam.이름.moveCamto([x, y]) for ms;
//                                   ms 동안 카메라를 [x, y] 로 옮김 (끝날 때까지 기다림 · for 가 없으면 바로) · 따라가기는 풀림
//   seo.cam.이름.follow("id");      오브젝트를 따라감 — 매 프레임 그 오브젝트가 화면 가운데 (카메라는 따라갈 수 없음)
//   seo.cam.이름.followOut();       따라가기 그만
//
// ── 카메라 = 오브젝트 ──────────────────
//   cam.이름.Position · cam.이름.Xpos · cam.이름.Ypos …   obj.id 와 같이 읽고 바꿈 (cam.main.Xpos = 100;)
//   dis.setObjPos("cam.main", [0, 0]);  · dis.setLink("cam.main", "hud");   명령의 id 에도 "cam.이름"
//   · 카메라에 묶거나(setLink) 자식으로 붙인 오브젝트는 카메라와 같이 움직임 → 화면에 붙어 있는 HUD
//   · 카메라가 있으면 can.MouseX · can.MouseY · isMouseTouched · 버튼 · bindInput 은 세계 좌표 (카메라 기준)
//
// ── 예 ─────────────────────────────────
//   run{
//       dis.setDisplay();
//       dis.setupObject();
//       seo.setUpCam();
//       seo.setCam("main");
//       dis.setObject([0, 0], "player", [40, 40], "#4de2b4");
//       seo.cam.main.follow("player");
//       seo.cam.main.setZoom(1.5);
//       loop{ if [jaw.isKeyInput("right")]{ obj.player.Xpos = obj.player.Xpos + 4; } dis.waitF(1); }
//   }
//
// · C 변환: 같은 카메라 위치 · 배율로 그림 (글자도 배율만큼).
