// jawbreaker — 기본 내장 라이브러리 (읽기 전용 설명서)
//
// ── 프로젝트 구조 ──────────────────────
//   프로젝트폴더/
//     project.jbs      최상위에 반드시 1개. 이 폴더가 프로젝트임을 표시
//     main.jb          코드 파일 (.jb)
//     lib/             라이브러리 파일(.jbl) 모음
//       base.jbl       Lib id base;
//       greet.jbl      Lib id greet parent base;
//
// ── project.jbs 형식 ───────────────────
//   jbs 1              (첫 줄, 필수)
//   name = 이름
//   main = main.jb     ▶ 실행할 기본 파일
//
// ── 코드 파일 (.jb) ────────────────────
//   Use jawbreaker call jaw;     라이브러리 id 를 별칭으로 사용
//   var 형식 call 이름 = 값;     최상위에는 Use, var, run 만
//   var public 형식 call 이름;   프로젝트 전체(모든 .jb · .jbl)가 함께 쓰는 변수
//                                · 선언할 때 값은 못 넣음 → run 안에서 이름 = 값;
//                                · 다른 파일에서도 같은 선언을 쓰면 같은 변수 (형식은 같아야 함)
//   run{ ... }                   실행할 코드는 run 안에! 여러 개 쓰면 모두 동시에 실행
//                                (최상위 var 는 공유 · wait 로 순서 맞추기 ·
//                                 한 run 에서 terminate/오류가 나면 전부 멈춤)
//
// ── 명령어 (jaw.명령어 / 그냥 명령어 둘 다 가능) ──
//   print(값) / log(값)   디버그 로그에 출력
//   wait(ms)              ms 밀리초 대기
//   isKeyInput("키")      그 키를 누르고 있으면 1, 아니면 0  (bit · 식 안에서)
//   fileExists("경로")    프로젝트에 그 파일이 있으면 1, 없으면 0  (bit · 식 안에서)
//                         · 경로: 프로젝트 기준 (./ ../ 는 이 파일 기준) · 폴더를 쓰면 그 안에 파일이 있을 때 1
//                         · 이번 실행에서 genJson 으로 만든 파일도 · C 실행 파일: 실행한 폴더 기준
//                         · 예: if [jaw.fileExists("save/s.json")]{ jaw.loadJson("save/s.json", "sav"); }
//                         · 글자 "a"~"z" · 숫자 "0"~"9" · "space" "enter" "esc" "tab" "backspace"
//                           "up" "down" "left" "right" "shift" "ctrl" "alt" (대소문자 구분 없음)
//                         · 한글 입력 상태여도 자판 위치로 알아봄 ("a" = ㅁ 자리) · 짧게 눌러도 최소 1 프레임은 1
//                         · 화면(DisPlayer)이 열려 있으면 모든 키 · 화면 없이 실행 중이면
//                           편집기(글 쓰는 칸) 밖에서 누른 키만 (실행 버튼을 누른 뒤 바로 키를 누르면 됨)
//                         · keyClick / keyPush 로 누른 키 · can.bindInput 으로 키에 묶은 버튼도 1
//                         · 예: if [jaw.isKeyInput("right")]{ obj.p.Xpos = obj.p.Xpos + 4; }
//   keyClick("키")        그 키를 톡 누른 것처럼 (1 프레임 동안 isKeyInput 이 1)
//   keyPush("키")         그 키를 누른 채로 둔 것처럼 (keyRlse 할 때까지 1)
//   keyRlse("키")         keyPush · keyClick 으로 누른 키를 뗌 (실제 키는 손을 떼야 0)
//   terminate()           진행 중인 작업 전체 종료 (동시 실행 중인 run 도 모두)
//   sendto("경로")        프로젝트 안의 .jb 파일로 넘어감 — 지금 run 은 여기서 끝 (돌아오지 않음)
//                         · 다음 줄은 실행되지 않음 · 같은 파일의 다른 run{ } 은 그대로 · 화면 · 오브젝트 · 소리는 유지
//                         · 서로 계속 넘어가도 됨 (메뉴 → 게임 → 메뉴 …, 횟수 제한 없음)
//                         (프로젝트 최상위 기준, ./ ../ 는 현재 파일 기준, 경로는 따옴표 안의 상수여야 함)
//   setup("경로")         프로젝트 안의 .jb 파일을 같이 실행 (기다리지 않고 바로 다음 줄로)
//                         · 프로그램은 setup 한 파일까지 모두 끝나야 종료
//   goTo(줄)              그 줄의 문장으로 넘어가 거기서부터 계속 (줄 번호는 편집기 왼쪽 숫자)
//                         · 지금 블록이나 그 바깥 블록에 있는 문장으로만 (loop 를 빠져나가 앞으로 돌아가기 등)
//                         · 안쪽 블록 · 다른 함수 · 다른 run 으로는 못 감 · 그 줄에서 시작하는 문장이어야 함
//                         · 예: 메뉴를 그리는 줄로 돌아가기 — goTo(42);   · C 변환은 줄 번호가 숫자 상수일 때만
//                         · 위아래 줄을 넣고 빼면 번호가 바뀌니 주의
//   break()               반복문 탈출 — 가장 안쪽 loop 를 빠져나감
//                         (loop 밖의 if 안이면 그 조건문을 빠져나감)
//   return()              반복문 처음으로 — 가장 안쪽 loop 의 조건 검사로 돌아감
//                         (loop 밖의 if 안이면 그 조건문 처음(조건 검사)으로)
//   return(값)            값을 돌려주는 함수에서 그 값을 돌려주고 빠져나감 (아래 라이브러리 참고)
//
// ── 문법 ───────────────────────────────
//   var 형식 call 이름;          형식: int float string bit  (matrix · list 는 아래)
//   이름 = 값;
//   "문장 %이름% 문장"           %변수명% → 변수 값 (%별칭.변수% 도 가능, %% = % 글자)
//   "Wild %dex[n]% appeared!"   %리스트[번호]% · %행렬[행, 열]% · %c[1][2]% 도 (대괄호 안은 식)
//   "Wild " dex[n] " appeared!" 문자열 바로 앞뒤에 값을 붙여 쓰면 이어 붙임 (= "Wild " + dex[n] + " appeared!")
//                                · 띄어쓰기는 따옴표 안에 · 예: print("Lv." lv "  HP " hp * 2);
//   if [조건]{ } else if [조건]{ } else{ }
//   loop [조건]{ }               조건이 참인 동안 반복 (while 대신)
//   [조건] and [조건]            대괄호 조건 여러 개를 이어 씀 (if · loop 모두)
//                                and · or · xor (둘 중 하나만) · nand · nor · not [조건] · && · || 도 됨
//                                우선순위 not > and · nand > xor > or · nor  ·  ( ) 로 묶기
//                                예: if [hp > 0] and not [jaw.isKeyInput("esc")] or ([x < 0] xor [y < 0]){ }
//   loop{ }                      무한 반복 (terminate() 로 끝내기)
//   loop for 1000{ }             1000 밀리초 동안 반복 (시작할 때 끝날 시각을 정함 · 반복을 시작하기 전에 시간을 확인)
//   loop [조건] for 3000{ }      조건이 참이고 3000ms 가 안 지났으면 반복
//                                break() · return() 도 그대로 · 안에서 wait · waitF 해도 됨
//
// ── 행렬 (matrix) ──────────────────────
//   var matrix[행, 열] call m;          float 만 들어가는 행렬 (번호는 1 부터)
//   var public matrix[1, 4] call coord; public 도 가능
//   m = [1, 1, 4 | 5, 1, 4];            , = 다음 열 · | = 다음 행 (크기가 같아야 함)
//   m[1, 4] = 4;                        성분 하나는 float 변수처럼 읽고 바꿈
//   var float call x = m[2, 1];
//   print(m);  "값 %m%"                 → [1, 1, 4 | 5, 1, 4]
//
// ── 리스트 (list) ──────────────────────
//   var list call anthropic;            빈 리스트 (항목은 숫자나 문자열 · 섞어도 됨)
//   var list call b = [1, 2, "셋"];     처음 항목을 넣어 만들기
//   anthropic[a]                        a번째 항목 (번호는 1 부터) — 바꾸기: anthropic[2] = "x";
//                                       범위 밖 번호에 넣으면 거기까지 늘어남 · 사이의 빈 항목은 0
//                                       (b = [1, 2]; b[5] = 9; → [1, 2, 0, 0, 9] · 읽기는 범위 안만)
//   anthropic.add(값);                  맨 뒤에 추가
//   anthropic.insert(번호, 값);         그 자리에 끼워 넣기 (뒤 항목은 한 칸씩 밀림)
//   anthropic.remove(번호);             그 항목 빼기
//   anthropic.clear();                  모두 비우기
//   anthropic.length                    항목 개수 (int)
//   anthropic.find(값)                  값이 처음 나오는 번호 (없으면 0)
//   print(anthropic);  "%anthropic%"    → [1, 2, "셋"]
//   · 항목을 숫자 자리에 쓰면 숫자인지, 문자열 자리에 쓰면 문자열인지 실행할 때 확인
//     (var int call x = b[1] + 1;   var string call s = b[3];)
//   · 항목끼리 + 는 둘 중 문자열이 있으면 이어 붙이고 아니면 더함 · - * / 는 실수 계산
//   · b = a; 는 복사 (b 를 바꿔도 a 는 그대로) · 함수 매개변수로는 못 씀 (public 리스트를 쓰세요)
//
// ── compound ───────────────────────────
//   리스트와 같지만 항목에 무엇이든 넣을 수 있음 — 숫자 · 문자열 · 행렬 · 리스트 · compound
//   var compound call c = [1, "이름", [1, 2 | 3, 4], b];   (b 는 리스트 변수)
//   c.add(m);  c.insert(1, b);  c.remove(2);  c.clear();  c.length  c.find(값)   리스트와 같음
//   c[3][1, 2]                          항목이 행렬이면 그 성분 (바꾸기: c[3][1, 2] = 5;)
//   c[4][2]                             항목이 리스트 · compound 이면 그 항목 (바꾸기: c[4][2] = "x";)
//   var matrix[2, 2] call m2 = c[3];    항목을 꺼낼 때는 쓰는 곳의 형식을 실행할 때 확인
//   var list call l2 = c[4];            (행렬은 크기까지 · 리스트 · compound · 숫자 · 문자열)
//   print(c);                           → [1, "이름", [1, 2 | 3, 4], [1, 2, "셋"]]
//   · 넣을 때 복사 (넣은 뒤 원래 변수를 바꿔도 c 안은 그대로) · == 와 find 는 안쪽까지 비교
//   · 리스트(list)에는 여전히 숫자 · 문자열만 — 행렬 · 리스트를 넣으려면 compound
//   · compound 안의 [ … ] 는 문자열 · 리스트 · 다른 [ … ] 등을 품으면 compound, 숫자만이면 행렬 ([x, y] 위치처럼)
//       var compound call party = [["피카츄", 35, [0, 0]], ["꼬부기", 44, [1, 2]]];   → party[2][1] = "꼬부기" · party[1][3] = [0, 0] (행렬)
//       party.add(["이상해씨", 45, [3, 3]]);   party[1] = ["라이츄", 60, [0, 0]];   party[1][2] = party[1][2] - 10;
//       var compound call bag = [];         [] = 빈 리스트 · compound
//
// ── data (바이트 그대로) ───────────────
//   var data call d = 값;          무엇이든 넣을 수 있고 무엇에든 넣을 수 있는 "데이터" (바이트 묶음)
//                                · 숫자 → 8바이트 실수 · 문자열 → UTF-8 · 행렬 · 리스트 · compound → JSON 글자
//   var int call n = d;            꺼낼 때는 받는 형식으로 억지로 읽음 — 안 맞으면 건너뜀
//                                · 숫자는 8바이트일 때만 · 문자열은 올바른 UTF-8 일 때만 · 리스트 · 행렬 · compound 는 JSON [ ] 일 때만
//                                · 건너뛰면: 대입은 원래 값 그대로 · 선언 · 매개변수는 기본값
//   print(d);   "" + d             16진수로 보임 (64바이트가 넘으면 앞 32바이트 … (크기 B))
//                                · 계산 (+ - == …) 은 안 됨 · 리스트 · compound 에 넣을 수 없음 (다른 형식으로 옮겨서)
//   data.d.getPart(시작, 끝)       그 구간의 바이트 (data · 식 안에서) — 번호는 0 부터 · 끝은 빠짐 (getPart(0, 4) = 앞 4바이트)
//                                · 범위 밖은 잘라 냄 · 끝 < 시작 이면 빈 data
//   data.d.setPart(시작, 끝, 값);  그 구간을 값의 바이트로 바꿈 (길이가 달라도 됨 · 시작 = 끝 이면 끼워 넣기)
//                                · 카메라 · 마이크에 연결된 data 는 먼저 연결을 풂 (그 순간의 바이트를 고침)
//   jaw.copyFileData("경로") as ("변수"); 프로젝트 파일의 바이트를 data 변수에 넣음 (이번 실행에서 쓴 파일도)
//   jaw.overWriteFile(값, "경로"); 값의 바이트로 파일을 덮어씀 · 쓰는 곳은 genJson 과 같음
//                                · 코드 (.jb · .jbl) · project.jbs · ext/ 에는 못 씀
//
// ── 수학 함수 (식 안에서 · jaw.sin(30) 도 가능) ──
//   sin(도) cos(도) tan(도)            각도는 기본 '도'   sin(30) → 0.5
//   sinRad(x) cosRad(x) tanRad(x)      이름 끝 Rad = 라디안   sinRad(pi() / 2) → 1
//   asin acos atan atan2(y, x)         결과가 도  (asinRad … atan2Rad 는 라디안)
//   sqrt(x) pow(a, b) ln(x) log10(x)   pi()
//   abs(x) min(a, b) max(a, b)         int 끼리면 int
//   floor(x) ceil(x) round(x)          → int
//   random(a, b)                       a 이상 b 미만의 무작위 실수
//   계산할 수 없는 값(sqrt(-1), asin(2) …)은 실행 오류
//   행렬끼리 + - 같은 계산은 아직 없음 (성분끼리는 가능)
//
// ── 문자열 함수 (식 안에서 · jaw.strLen(s) 도 가능) ──
//   글자 번호는 1 부터 · 한글 · 이모지도 한 글자
//   strLen(s)                       글자 수 → int                strLen("가나다") → 3
//   subStr(s, 시작, 개수)            시작 번째 글자부터 개수만큼   subStr("Jawbreaker", 4, 5) → "break"
//   charAt(s, n)                    n 번째 글자 (없으면 "")
//   findStr(s, t)                   t 가 처음 나오는 글자 번호 → int (없으면 0)
//   replaceStr(s, 찾을것, 바꿀것)     모두 바꿈
//   upperStr(s) · lowerStr(s)       영문 대문자 · 소문자로
//   trimStr(s)                      앞뒤 공백 · 줄바꿈 제거
//   startsWith(s, t) · endsWith(s, t)   t 로 시작 · 끝나면 1 (bit)
//   toInt(s) · toFloat(s)           문자열 → 숫자 (숫자가 아니면 0)   toInt(" 42 ") → 42
//   splitStr(s, 구분자)              list 로 나눔 — 리스트 변수에 바로 넣을 때만
//                                   var list call a = splitStr("a,b,c", ",");   (구분자 "" = 한 글자씩)
//   숫자 → 문자열은 "" + 값   (예: "점수: " + score)
//
// ── JSON 저장 ──────────────────────────
//   jaw.setJson("id", 값);           값을 id 로 담아 둠 (그때의 복사본) — 숫자 · 문자열 · 행렬 · 리스트 · compound
//                                    [ … ] 를 바로 쓰면 compound:  jaw.setJson("save", [3, "Lee", [10, 20]]);
//                                    · 같은 id 로 다시 쓰면 바뀜
//   jaw.genJson("경로.json", "id");   담아 둔 값을 JSON 파일로 저장   → [3,"Lee",[10,20]]
//                                    · 숫자 → 숫자 · 문자열 → "…" · 리스트 · compound → [ … ]
//                                    · 행렬: 한 줄이면 [x, y], 여러 줄이면 [[…], […]]
//                                    · 경로: 프로젝트 기준 (./ 로 시작하면 이 파일 기준) · 폴더/이름.json 가능 · 있으면 덮어씀
//                                    · 편집기: 프로젝트에 .json 파일이 생김 (탐색기 · 저장해야 남음)
//                                    · C 실행 파일: 실행한 폴더 기준으로 씀 · 내보낸 HTML: 파일을 내려받음
//   jaw.loadJson("경로.json", "변수");  JSON 파일을 읽어 compound 변수에 넣음 (원래 값은 바뀜)
//                                    var compound call sav;   jaw.loadJson("save/s.json", "sav");   print(sav[2]);
//                                    · 변수 이름은 "따옴표" 로 · 그 변수는 compound 여야 함
//                                    · [ ] → compound · 숫자 · 문자열 그대로 · true/false → 1/0 · null → 0
//                                    · 행렬로 저장했던 [x, y] 도 compound 로 읽힘 (sav[3][1] 처럼 꺼냄)
//                                    · 맨 바깥이 [ ] 가 아니면 [값] 으로 · { } (객체)는 읽지 않음 (오류)
//                                    · 이번 실행에서 genJson 으로 쓴 파일도 바로 읽음 · C 실행 파일은 실행한 폴더 기준
//
// ── 라이브러리 (.jbl, lib/ 폴더) ───────
//   Lib id greet parent base;    id 로 구분, parent 는 선택
//   var / func 만 정의 — 부모의 함수·변수를 그대로 물려받음
//   func hello(string who){ ... }
//   다른 파일에서:  Use greet call g;   g.hello("x");
//   func int add(int a, int b){ return(a + b); }
//                                값을 돌려주는 함수 — func 다음에 돌려줄 형식 (int float string bit matrix[행, 열] list compound)
//   다른 파일에서:  var int call s = g.add(1, 2);   print(g.add(3, 4) * 2);
//   · return(값) 없이 끝나면 0 / "" / 빈 리스트 / 0 행렬 · 문장으로 g.add(1, 2); 처럼 불러도 됨 (값은 버림)
//   · 매개변수 · 돌려주는 값에 list · compound · matrix[행, 열] 도 됨 — 넘기고 받을 때 복사 (함수 안에서 바꿔도 넘긴 변수는 그대로)
//       func compound hit(compound mon, int dmg){ mon[2] = mon[2] - dmg; return(mon); }
//       func matrix[1, 2] mid(matrix[1, 2] a, matrix[1, 2] b){ return([(a[1, 1] + b[1, 1]) / 2, (a[1, 2] + b[1, 2]) / 2]); }
//       var compound call p = ["피카츄", 35]; p = g.hit(p, 10);   g.hit(["꼬부기", 44], 3); 처럼 [ … ] 를 바로 넘겨도 됨
//     · 돌려받은 리스트 · compound 는 변수에 넣거나 print · 다른 함수에 넘겨 씀 (g.f()[1] 처럼 바로 꺼내기는 아직 안 됨)
//   · 식 안에서 부른 함수는 기다리지 않고 끝까지 한 번에 실행
//     → 그 안에서는 wait · dis.waitF · moveObj … for · sendto 를 쓸 수 없음
//
// ── 내장 라이브러리 ────────────────────
//   jawbreaker   이 설명서
//   DisPlayer    화면 라이브러리 → DisPlayer.jbl 참고   (Use DisPlayer call dis;)
//   colliders    DisPlayer 하위 · 속도 → colliders.jbl 참고   (Use colliders call col;)
//   Canvas       DisPlayer 하위 · 입력 (클릭 · 마우스) · 장면 → Canvas.jbl 참고   (Use Canvas call can;)
//   Magellan     DisPlayer 하위 · 이미지 · 텍스쳐 · 소리 파일 → Magellan.jbl 참고   (Use Magellan call mag;)
//   soundMaster  Magellan 하위 · 스피커 · 효과음 · 공간 음향 → soundMaster.jbl 참고   (Use soundMaster call sou;)
//   SeongBin     Canvas 하위 · 카메라 → SeongBin.jbl 참고   (Use SeongBin call seo;)
