Use jawbreaker call jaw;
Use DisPlayer call dis;
Use Magellan call mag;
Use deviceManager call dem;

run{
    jaw.getPermit("file");
    var bit call f = jaw.hasPermit("file");
    print("file=%f%");
    jaw.getPermit("cam");
    jaw.getPermit("mic");
    var bit call c = jaw.hasPermit("cam");
    var bit call m = jaw.hasPermit("mic");
    print("cam=%c% mic=%m%");
    dis.setDisplay();
    dis.setupObject();
    dis.setObject([0, 0], "tv", [400, 300], "#000000");
    var data call video;
    var data call sound;
    if [c == 1]{
        dem.recordCamAs("video");
        mag.wearTexture("tv", video);
        jaw.wait(500);
        var data call photo = video;
        print("video=" + photo);
    }
    if [m == 1]{
        dem.recordMicAs("sound");
        jaw.wait(300);
        var data call clip = sound;
        print("sound=" + clip);
    }
    if [c == 1]{
        dem.stopRecord("video");
    }
    dem.stopRecord("sound");
    print("stopped");
}
