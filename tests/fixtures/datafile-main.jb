Use jawbreaker call jaw;

run{
    var data call d = "Hello, World";
    var data call p = data.d.getPart(0, 5);
    var string call ps = p;
    print("part=%ps%");
    data.d.setPart(7, 12, "JB");
    var string call ds = d;
    print("set=%ds%");
    data.d.setPart(0, 0, ">");
    data.d.setPart(100, 200, "!");
    ds = d;
    print("ins=%ds%");
    var data call e = data.d.getPart(5, 2);
    print("empty=[%e%]");
    data.d.setPart(1, 3, 255);
    print("num=%d%");
    var int call k = data.d.getPart(1, 9);
    print("k=%k%");
    var data call c = "abc";
    var data call c2 = c;
    data.c.setPart(0, 1, "X");
    data.c2.setPart(2, 3, "Z");
    var string call cs = c;
    var string call cs2 = c2;
    print("cow=%cs% %cs2%");
    jaw.overWriteFile("line1", "doc/out.txt");
    var data call r;
    jaw.copyFileData("doc/out.txt") as ("r");
    data.r.setPart(4, 5, "2");
    jaw.overWriteFile(r, "doc/out.txt");
    var data call r2;
    jaw.copyFileData("doc/out.txt") as ("r2");
    var string call rs = r2;
    print("file=%rs%");
}
