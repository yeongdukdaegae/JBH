Use jawbreaker call jaw;

run{
    var data call d = 255;
    print("d=%d%");
    var int call n = d;
    print("n=%n%");
    var data call s = "hi";
    print("s=" + s);
    var string call t = s;
    print("t=%t%");
    var int call k = 7;
    k = s;
    print("k=%k%");
    var int call k2 = s;
    print("k2=%k2%");
    var string call bad = "keep";
    bad = d;
    print("bad=%bad%");
    var float call f = 0.5;
    var data call fd = f;
    var bit call b = fd;
    var float call f2 = fd;
    print("fd=%fd% b=%b% f2=%f2%");
    var matrix[2, 2] call m;
    m = [1, 2 | 3, 4];
    var data call md = m;
    var matrix[2, 2] call m2 = md;
    print("md=" + md);
    print("m2=%m2%");
    var matrix[3, 1] call m3;
    m3 = md;
    print("m3=%m3%");
    var list call l = [1, "x", 3];
    var data call ld = l;
    var list call l2 = ld;
    var string call ls = ld;
    print("ls=%ls% l2=%l2%");
    var compound call c = [1, "a", [2, 3]];
    var data call cd = c;
    var compound call c2 = cd;
    print("c2=%c2%");
    var list call l3 = [9];
    l3 = cd;
    print("l3=%l3%");
    var data call e;
    print("e=[%e%]");
    var data call big = "0123456789012345678901234567890123456789012345678901234567890123456789";
    print("big=%big%");
    var data call d2 = d;
    d = "z";
    print("d2=%d2% d=%d%");
    var data call num = "3";
    var int call three = num;
    print("three=%three%");
    var data call jn = "[true, null, 2]";
    var list call lb = jn;
    print("lb=%lb%");
}
