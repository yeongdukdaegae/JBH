Use jawbreaker call jaw;
Use DisPlayer call dis;
Use Canvas call can;
Use SeongBin call seo;
Use Layers call ly;

run{
    dis.setDisplay();
    dis.setupObject();
    seo.setUpCam();
    dis.setObject([0, 0], "a", [200, 200], "#808080");
    dis.setObject([0, 0], "b", [100, 100], "#ffffff");
    dis.setObjLayer("b", 5);
    seo.cam.default.moveCamto([50, 0]);
    ly.paint();
    jaw.wait(400);
    print("layers painted");
}
